{
  "name": "browser-bridge",
  "version": "1.4.0",
  "private": true,
  "description": "Approval-gated browser-to-local-shell bridge",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:all": "node --test tests/*.test.js",
    "check": "find extension -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": { "node": ">=18" }
}
